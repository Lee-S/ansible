[Unit]
Description=Backup failure notification for %i

[Service]
Type=oneshot
ExecStart=/bin/bash -c '(echo "To: {{ notify_email }}"; echo "Subject: BACKUP FAILED: %i on {{ machine_id }}"; echo "From: {{ smtp_from }}"; echo ""; echo "Backup service %i failed on {{ machine_id }} at $(date)"; echo ""; echo "Check journalctl -u %i for details") | msmtp {{ notify_email }}'
